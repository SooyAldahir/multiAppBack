# Servidor
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS separados por coma (* = todos, solo en desarrollo)
CORS_ORIGIN=*

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=multiApp
DB_USER=sa
DB_PASSWORD=TuPasswordSegura123!
# SQL Server local: DB_ENCRYPT=false y DB_TRUST_SERVER_CERTIFICATE=true
# Azure SQL:        DB_SERVER=tu-servidor.database.windows.net, DB_ENCRYPT=true, DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticación (cambia JWT_SECRET por una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Recetario con IA (Groq, nivel gratuito)
# Clave: https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Modelo con visión para calcular calorías con foto (revisa npm run ai:check)
AI_VISION_MODEL=qwen/qwen3.8-27b

# Mapas (OpenStreetMap, gratis y sin clave). Opcionales:
# correo de contacto que exige la política de uso de Nominatim
GEO_CONTACT_EMAIL=
# países donde buscar direcciones (códigos separados por coma; vacío = todo el mundo)
GEO_COUNTRY_CODES=mx

# Fotos de perfil en Cloudinary (opcional; plan gratuito en https://cloudinary.com)
# Las fotos de comida solo se analizan con IA y no se guardan.
# Copia el "API environment variable" de tu Dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=multiapp

# Notificaciones push con Firebase Cloud Messaging (opcional)
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# Guarda el JSON junto al backend (no lo subas a git) y pon su ruta, ej. ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
# o bien pega el JSON completo en una sola línea:
FIREBASE_SERVICE_ACCOUNT_JSON=
